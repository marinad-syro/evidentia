# xAI (Grok) — required for search, voice, and card generation
XAI_API_KEY=xai-...

# Tavily — required for live provider verification
TAVILY_API_KEY=tvly-...

# Databricks — required for geographic SQL filtering
# Falls back to local pandas if unavailable
DATABRICKS_HOST=your-workspace.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id
DATABRICKS_TOKEN=dapi...
DATABRICKS_CATALOG=hive_metastore
DATABRICKS_SCHEMA=default
DATABRICKS_TABLE=providers

# CORS — comma-separated list of allowed frontend origins in production
# ALLOWED_ORIGINS=https://evidentia.up.railway.app

# OpenAI — optional, only needed if using OpenAI embeddings instead of local model
# OPENAI_API_KEY=sk-...
